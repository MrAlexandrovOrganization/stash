GO_VERSION := $(shell awk '$$1 == "go" {print $$2; exit}' go.mod)
PROTOC_GEN_GO_VERSION := $(shell awk '$$1 == "google.golang.org/protobuf" {print $$2; exit}' go.mod)
BUF_VERSION := 1.67.0
PROTOC_GEN_GO_GRPC_VERSION := 1.6.1
ALPINE_VERSION := 3.21
PGVECTOR_VERSION := pg17
OLLAMA_VERSION := 0.30.5
VERSION_VARS := GO_VERSION PROTOC_GEN_GO_VERSION BUF_VERSION PROTOC_GEN_GO_GRPC_VERSION ALPINE_VERSION PGVECTOR_VERSION OLLAMA_VERSION
export $(VERSION_VARS)

PYTHON_VERSION := 3.12
export PYTHON_VERSION

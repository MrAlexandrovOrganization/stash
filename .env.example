MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional: log level (debug|info|warn|error, case-insensitive; default info).
LOG_LEVEL=info

# Optional: Whisper transcription service (gRPC).
# Leave WHISPER_HOST empty to disable automatic video transcription.
WHISPER_HOST=
WHISPER_PORT=50053

# Optional: vision model for automatic AI descriptions of images.
# Requires an Ollama instance reachable from the stash container
# (e.g. the ollama-net network). Set OLLAMA_URL empty to disable.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llava

# Optional: background worker that periodically generates missing AI
# descriptions (e.g. for items uploaded while Ollama was down). Accepts a
# Go duration string like "5m"; leave empty to disable.
AI_DESCRIPTION_BACKFILL_INTERVAL=5m
AI_DESCRIPTION_BACKFILL_BATCH=5

# Optional: text embedding model (Ollama) for item-description search.
# Multilingual models (e.g. bge-m3) give the best Russian-language results.
# Leave OLLAMA_EMBED_MODEL empty to disable text embeddings.
OLLAMA_EMBED_MODEL=bge-m3

# Optional: image/text embedding microservice over gRPC (open_clip, separate
# clip-embedder repo). Leave CLIP_EMBEDDER_ADDR empty to disable image
# embeddings. When set, the backend embeds uploaded media and serves
# similarity search at GET/POST /similar.
CLIP_EMBEDDER_ADDR=clip-embedder:50051

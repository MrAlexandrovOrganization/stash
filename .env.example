MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional: Whisper transcription service (gRPC).
# Leave WHISPER_HOST empty to disable automatic video transcription.
WHISPER_HOST=
WHISPER_PORT=50053

# Optional: vision model for automatic AI descriptions of images.
# Requires an Ollama instance reachable from the stash container
# (e.g. the ollama-net network). Set OLLAMA_URL empty to disable.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llava

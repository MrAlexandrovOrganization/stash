STACK_ROLE=workers
COMPOSE_PROJECT_NAME=stash-workers
WORKER_AUTODEPLOY=1
WORKER_ENDPOINT=workers.example.com:443
CPU_WORKER_ID=stash-wsl-cpu
CPU_WORKER_TOKEN_PATH=/path/to/stash-wsl-cpu.token
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=bge-m3:567m
OLLAMA_CPU_LIMIT=2
OLLAMA_MEMORY_LIMIT=6g
WORKER_UID=1000
WORKER_GID=1000

# Worker process and FFmpeg; Ollama has a separate limit.
WORKER_MEMORY_LIMIT=512m
WORKER_CPU_LIMIT=2

STACK_ROLE=workers
COMPOSE_PROJECT_NAME=stash-workers
WORKER_AUTODEPLOY=1
WORKER_ENDPOINT=workers.example.com:443
CPU_WORKER_ID=stash-mac-cpu
CPU_WORKER_TOKEN_PATH=/path/to/stash-mac-cpu.token
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=bge-m3:567m
OLLAMA_CPU_LIMIT=2
OLLAMA_MEMORY_LIMIT=6g
WORKER_UID=501
WORKER_GID=20

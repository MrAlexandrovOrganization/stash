stage.match {
	selector = `{service=~"(ollama|stash-workers)/ollama"}`

	stage.regex {
		expression = `^\[GIN\] [0-9]{4}/[0-9]{2}/[0-9]{2} - [0-9]{2}:[0-9]{2}:[0-9]{2} \|\s*(?P<http_status>[1-5][0-9]{2})\s*\|[^|]+\|\s*(?P<http_client>[^ |]+)\s*\|\s*(?P<http_method>[A-Z]+)\s+"(?P<http_path>[^"]*)"\s*$`
	}
	// GIN has no severity: classify status, with successful local probes at debug.
	stage.template {
		source   = "text_level"
		template = `{{ if .http_status }}{{ if ge .http_status "500" }}error{{ else if ge .http_status "400" }}warn{{ else if and (ge .http_status "200") (lt .http_status "300") (or (eq .http_client "127.0.0.1") (eq .http_client "::1")) (or (and (eq .http_method "HEAD") (eq .http_path "/")) (and (eq .http_method "GET") (eq .http_path "/api/tags"))) }}debug{{ else }}info{{ end }}{{ else }}unknown{{ end }}`
	}
}

stage.match {
	selector = `{service="stash/stash-tailnet"}`
	// Tailscale has no native severity. Only these routine events have a policy;
	// an unfamiliar event stays unknown so a new failure cannot become info.
	stage.regex {
		expression = `^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} (?P<tailnet_routine>(netcheck: ((netcheck: )?UDP is blocked, trying (ICMP|HTTPS)|DetectCaptivePortal\(found=false\))|magicsock: (new contact: .+|derp-[0-9]+ connected; connGen=[0-9]+)|derphttp\.Client\.(Recv|Send): connecting to derp-[0-9]+ \([^)]*\)|control: (controlhttp: forcing port 443 dial due to recent noise dial|trying bootstrapDNS\(.+ \.\.\.|NetInfo: .+|controlclient direct: (updating discoKey for .+ via mapSession|got TSMP disco key advertisement from .+ via eventbus))))$`
	}

	stage.regex {
		expression = `^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} (?P<tailnet_retry_warning>(Received error: .+|control: (map response long-poll timed out!|lite map update error after .+|bootstrapDNS\(.+ error: .+)|magicsock: (.*(context deadline exceeded|connect: .+|no such host)|derp-[0-9]+ does not know about peer .+, removing route)|open-conn-track: timeout opening .+|\[RATELIMIT\] .+))$`
	}

	stage.template {
		source   = "text_level"
		template = `{{ if .tailnet_retry_warning }}warn{{ else if .tailnet_routine }}debug{{ else }}{{ .Value }}{{ end }}`
	}
}

stage.match {
	selector = `{service=~"(ollama|stash-workers)/ollama"}`
	// Native llama-server progress has no severity prefix. Keep it scoped and
	// recognize known functions; unfamiliar output is still visible as unknown.
	stage.regex {
		expression = `^(?P<llama_progress>(print_info|llama_model_loader|load_hparams|llama_context|llama_kv_cache|clip_model_loader|clip_ctx|load_tensors|sched_reserve|common_init_result|common_params_fit_impl|common_memory_breakdown_print|common_fit_params|common_speculative_init|common_init_from_params|common_params_print_info|reserve_compute_meta|system_info|device_info|log_info|handle_qwen[0-9a-z_]+|init|warmup|load|compat tensor transform): .+|slot +[a-z_]+: id +[0-9]+ \| task -?[0-9]+ \| .+|srv +[a-z_]+: .+|encoding image slice\.\.\.|image slice encoded in [0-9]+ ms|decoding image batch [0-9]+/[0-9]+, n_tokens_batch = [0-9]+|\.{3,})$`
	}

	stage.regex {
		expression = `(?i)^(?P<llama_failure>[^\n]*(fatal|panic|out of memory|failed to |unable to |cannot |error:)[^\n]*)$`
	}

	stage.regex {
		expression = `(?i)^(?P<llama_warning>[^\n]*(warning:|probably a bug|not supported)[^\n]*)$`
	}

	stage.regex {
		expression = `^srv +log_server_[a-z_]*: done request: [A-Z]+ [^ ]+ [^ ]+ (?P<llama_http_status>[1-5][0-9]{2})$`
	}

	stage.template {
		source   = "text_level"
		template = `{{ if .llama_failure }}error{{ else if .llama_warning }}warn{{ else if .llama_http_status }}{{ if ge .llama_http_status "500" }}error{{ else if ge .llama_http_status "400" }}warn{{ else }}debug{{ end }}{{ else if .llama_progress }}debug{{ else }}{{ .Value }}{{ end }}`
	}
}

    {
      "title": "Серверному fallback разрешено брать задания",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "description": "Fallback разрешён, когда нет готовых приоритетных воркеров с совместимыми моделями. Это не означает, что сервер сейчас занят. TTL отчёта — 90 секунд.",
      "targets": [
        {
          "refId": "A",
          "expr": "compute_fallback_allowed{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",

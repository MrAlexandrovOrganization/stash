          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(compute_worker_online, service)",
        "query": {
          "query": "label_values(compute_worker_online, service)",
          "refId": "service-variable"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "worker",
        "label": "Воркер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(compute_worker_online{service=~\"$service\"}, worker_id)",

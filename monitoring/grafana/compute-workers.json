    {
      "title": "Доступность и занятость воркеров",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "Offline — нет ready-отчёта в пределах TTL (90 с по умолчанию). Готов — модели доступны, Занят — есть действующий lease. Пробел означает отсутствие наблюдений, а не offline. У Stash ready подтверждает наличие моделей в Ollama; у CLIP — загрузку модели. Это не гарантия успешного инференса. Простой Mac/WSL ожидаем.",
      "targets": [
        {
          "refId": "A",
          "expr": "compute_worker_state{service=~\"$service\",worker_id=~\"$worker\"}",
          "legendFormat": "{{service}} / {{worker_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "#8e8e8e"
                },
                "1": {
                  "text": "Готов",
                  "color": "green"
                },
                "2": {
                  "text": "Занят",
                  "color": "blue"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 7
    },

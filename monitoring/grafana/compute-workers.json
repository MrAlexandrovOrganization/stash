          "query": "label_values(compute_worker_online{service=~\"$service\"}, worker_id)",
          "refId": "worker-variable"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
